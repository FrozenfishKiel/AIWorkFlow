# Optional runtime directory override
APP_RUNTIME_DIR=

# Database / queue
DATABASE_URL=
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0

# Formal AI chain
TASK_GENERATION_PROVIDER=auto
RETRIEVAL_PROFILE_PROVIDER=auto
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_SECONDS=45
RETRIEVAL_EMBEDDING_DIMENSION=128

# Optional auth
API_ACCESS_TOKEN=
AUTH_LOGIN_USERNAME=
AUTH_LOGIN_PASSWORD=
AUTH_SECRET_KEY=
AUTH_TOKEN_TTL_MINUTES=480
AUTH_TOKEN_ISSUER=ai-content-ops

# Local demo fallback when Redis / Celery is unavailable
ALLOW_INLINE_BACKGROUND_FALLBACK=true
